# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Anthropic API key for the diffing agent's own model calls (console.anthropic.com)
ANTHROPIC_API_KEY=

# OPTIONAL - leave unset. A workspace-scoped API key needs no workspace header.
# Only an identity-linked key requires one; set it to wrkspc_01ABC... in that case
# (Console -> Settings -> Workspaces) and the harness will send it as a header.
# ANTHROPIC_WORKSPACE_ID=

# OpenRouter key, used for cross-provider judge/baseline calls (openrouter.ai/keys)
OPENROUTER_API_KEY=

# HuggingFace token - model downloads and pushing adapters/datasets to a private repo
HF_TOKEN=

# RunPod API key for programmatic pod management - console.runpod.io -> Settings -> API Keys
RUNPOD_API_KEY=

# Pod SSH host from the RunPod "Connect" panel (e.g. 194.26.196.xxx)
POD_SSH_HOST=

# Pod SSH port from the RunPod "Connect" panel - exposed TCP, not 22
POD_SSH_PORT=

# Base URL of the vLLM OpenAI-compatible server (scripts/serve_ladder.py serve).
# Keep it as the loopback URL below and forward the port instead of exposing the
# server publicly - the pod's vLLM has no auth:
#   ssh -N -L 8000:127.0.0.1:8000 root@$POD_SSH_HOST -p $POD_SSH_PORT
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Optional: only if you start vLLM with --api-key. Blank means no auth header.
VLLM_API_KEY=
