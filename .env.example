# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Anthropic API key for the diffing agent's own model calls (console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenRouter key, used for cross-provider judge/baseline calls (openrouter.ai/keys)
OPENROUTER_API_KEY=

# HuggingFace token - model downloads and pushing adapters/datasets to a private repo
HF_TOKEN=

# RunPod API key for programmatic pod management - console.runpod.io -> Settings -> API Keys
RUNPOD_API_KEY=

# Pod SSH host from the RunPod "Connect" panel (e.g. 194.26.196.xxx)
POD_SSH_HOST=

# Pod SSH port from the RunPod "Connect" panel - exposed TCP, not 22
POD_SSH_PORT=

# Base URL of the vLLM OpenAI-compatible server on the pod (e.g. http://127.0.0.1:8000/v1)
VLLM_BASE_URL=
